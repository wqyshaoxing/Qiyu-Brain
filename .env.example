# Qiyu-Brain 配置模板
# 复制为 .env 后填写。.env 已被 gitignore，绝不会提交。
#   cp .env.example .env
# 优先级：已存在的系统环境变量 > .env > config/schema.json 的默认值。

# ── 检索（shared/input/search-connectors）──────────────────────
# Crossref 礼貌池：填邮箱可获得更稳定的限流待遇，非必填
CROSSREF_MAILTO=

# Semantic Scholar：可选，未填则走匿名限流
SEMANTIC_SCHOLAR_API_KEY=

# PubMed E-utilities：可选，未填则限 3 次/秒
PUBMED_API_KEY=

# Exa 语义检索：可选，付费。未配置则 search-connectors 跳过 exa 来源
EXA_API_KEY=

# ── 文献管理（academic-research/input/zotero-import）───────────
# https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user

# ── PDF 解析（academic-research/input/mineru-extract）──────────
# https://mineru.net 控制台申请
MINERU_API_KEY=

# ── 本地界面（scripts/gui.py）──────────────────────────────────
# 只监听 127.0.0.1；改端口用于避免冲突
QIYU_GUI_HOST=127.0.0.1
QIYU_GUI_PORT=8765
