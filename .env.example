# ╔════════════════════════════════════════════════════════════════╗
# ║  Qiyu-Brain 配置                                                ║
# ║                                                                ║
# ║  用法：cp .env.example .env  然后只填你有的行。                 ║
# ║        留空 = 该来源自动跳过（记 skipped），不影响其它来源。     ║
# ║  检测：python shared/input/web-search/scripts/web_search.py \   ║
# ║        --doctor                                                ║
# ║  安全：.env 已 gitignore，永不提交。                            ║
# ║        不要把 key 写进 SKILL.md、日志或任何交付物。             ║
# ╚════════════════════════════════════════════════════════════════╝

# ┌──────────────────────────────────────────────────────────────┐
# │  分区索引                                                     │
# │  ① 免 key 检索源      无需填写，开箱即用                       │
# │  ② 网页检索 · 通用     需 key，10 个                           │
# │  ③ 网页检索 · 中文     需 key，3 个                            │
# │  ④ 网页检索 · 自建     SearXNG 地址                           │
# │  ⑤ 学术检索           全部可选                                │
# │  ⑥ 文献管理           Zotero                                  │
# │  ⑦ PDF 解析           MinerU                                  │
# │  ⑧ 本地界面           GUI                                     │
# └──────────────────────────────────────────────────────────────┘

# ═══════════════════════════════════════════════════════════════
# ① 免 key 检索源 —— 无需填写，此处仅作说明
# ═══════════════════════════════════════════════════════════════
#   duckduckgo     通用网页（HTML 解析，较脆弱）
#   wikipedia      百科
#   hn             Hacker News（Algolia）
#   stackexchange  技术问答
#
#   运行：--providers free
#   这四项不需要任何 key，也不要往下面加重复的键。

# ═══════════════════════════════════════════════════════════════
# ② 网页检索 · 通用（需 key）
# ═══════════════════════════════════════════════════════════════

# Tavily —— 面向 AI 的检索，免费额度最友好，建议第一个试
# 申请 https://app.tavily.com/home
TAVILY_API_KEY=

# Exa —— 语义/神经检索，按结果计费；学术与网页两个技能共用
# 申请 https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Brave Search —— 独立索引，不转售 Google（$20/月 免费额度，最划算的一个）
# 注意：开通需要绑定支付方式验证，暂未填写
# 申请 https://brave.com/search/api/
BRAVE_API_KEY=

# Jina Search —— s.jina.ai，返回带正文的 JSON
# 申请 https://jina.ai/api-dashboard/
JINA_API_KEY=

# Firecrawl —— 检索与抓取一体
# 申请 https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Linkup —— 欧洲索引，按查询计费
# 申请 https://app.linkup.so
LINKUP_API_KEY=

# Google Programmable Search —— 必须成对填写，缺一个就跳过（有每日免费额度）
# 申请 https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ═══════════════════════════════════════════════════════════════
# ③ 网页检索 · 中文
#   百度与搜狗没有可用的公开接口；智谱无免费额度、博查额度不可用，均已移除
#   实测：LangSearch 与现有四源对中文查询覆盖已经足够（15/16 条中文结果）
# ═══════════════════════════════════════════════════════════════

# LangSearch —— 中英双语，完全免费的免费计划（已实测可用）
# 申请 https://langsearch.com
LANGSEARCH_API_KEY=

# ═══════════════════════════════════════════════════════════════
# ④ 网页检索 · 自建
#   SearXNG 是元搜索，可间接覆盖百度 / 必应 / Google
#   公共实例普遍关闭 JSON，因此这里只认自建地址
#   部署 https://docs.searxng.org/admin/installation.html
# ═══════════════════════════════════════════════════════════════
# 例：http://127.0.0.1:8080
SEARXNG_URL=

# ═══════════════════════════════════════════════════════════════
# ⑤ 学术检索（shared/input/search-connectors）
#   全部可选：不填也能跑 arXiv / Crossref / OpenAlex
# ═══════════════════════════════════════════════════════════════

# Crossref 礼貌池：填邮箱即可，无需注册
CROSSREF_MAILTO=

# PubMed：不填按 3 次/秒限流，通常够用
PUBMED_API_KEY=
# 说明：Semantic Scholar 匿名即可用（限流更低），因此不再提供 key 配置项。

# ═══════════════════════════════════════════════════════════════
# ⑥ 文献管理
#   由 BoomSkills 的 zotero-batch-pdf-import 消费，Qiyu-Brain 不重复实现
# ═══════════════════════════════════════════════════════════════

# 申请 https://www.zotero.org/settings/keys（只勾读写权限）
ZOTERO_API_KEY=
# keys 页面右上角的数字 ID
ZOTERO_LIBRARY_ID=
# user 或 group
ZOTERO_LIBRARY_TYPE=user

# ═══════════════════════════════════════════════════════════════
# ⑦ PDF 解析
#   由 BoomSkills 的 mineru-pdf-to-markdown 消费，Qiyu-Brain 不重复实现
# ═══════════════════════════════════════════════════════════════

# 申请 https://mineru.net
MINERU_API_KEY=

# ═══════════════════════════════════════════════════════════════
# ⑧ 本地界面
# ═══════════════════════════════════════════════════════════════

# 只监听本机，不要改成 0.0.0.0
QIYU_GUI_HOST=127.0.0.1
QIYU_GUI_PORT=8765
