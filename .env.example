# Qiyu-Brain 配置模板
# 复制为 .env 后填写。.env 已被 gitignore，绝不会提交。
#   cp .env.example .env
# 优先级：已存在的系统环境变量 > .env > config/schema.json 的默认值。

# ── 检索（shared/input/search-connectors）──────────────────────
# Crossref 礼貌池：填邮箱可获得更稳定的限流待遇，非必填
CROSSREF_MAILTO=

# Semantic Scholar：可选，未填则走匿名限流
SEMANTIC_SCHOLAR_API_KEY=

# PubMed E-utilities：可选，未填则限 3 次/秒
PUBMED_API_KEY=

# Exa 语义检索：可选，付费。search-connectors 与 web-search 共用
EXA_API_KEY=

# ── 网页检索（shared/input/web-search）──────────────────────────
# 免 key 可用：duckduckgo、wikipedia。以下全部可选，未配置则该来源跳过
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# 自建 SearXNG 实例地址，例如 http://127.0.0.1:8080
# 公共实例通常禁用 format=json，因此这里只认自建地址
SEARXNG_URL=

# ── 文献管理（academic-research/input/zotero-import）───────────
# https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user

# ── PDF 解析（academic-research/input/mineru-extract）──────────
# https://mineru.net 控制台申请
MINERU_API_KEY=

# ── 本地界面（scripts/gui.py）──────────────────────────────────
# 只监听 127.0.0.1；改端口用于避免冲突
QIYU_GUI_HOST=127.0.0.1
QIYU_GUI_PORT=8765
